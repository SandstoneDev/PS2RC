/* hooks.def - guest functions the HLE runtime replaces (HOOK) or wraps with a call log (TRACE).
 *
 * The pipeline's prepare_gen.py renames the generated definition of every listed function to fn_<addr>__guest
 * (ov<N>_fn_<addr>__guest for *_OV) in the build copy of the translation; HOOK functions are then defined by hand in
 * the HLE modules (HLE(addr) / HLE_OV(ov, addr)), TRACE wrappers are generated by the core's hle_traces.c from this
 * file.
 *   HOOK(addr, name)                 TRACE(addr, name, flags)    flags: 1 = milestone on the first call
 *   HOOK_OV(ov, addr, name)          TRACE_OV(ov, addr, name, flags)
 * Addresses: 8 lowercase hex digits (they are pasted into C identifiers). The names of the game's own functions are
 * labels only, the address is what counts.
 */

/* ---- libkernl (kernel internals, threads, timers, tty) */
HOOK(00546318, _InitSys)
HOOK(0053cd78, InitThread)
HOOK(0053d018, DelayThread)
HOOK(0053d0e0, StartThread)
HOOK(0053ce68, iWakeupThread)
HOOK(0053cf00, iRotateThreadReadyQueue)
HOOK(0053cf80, iSuspendThread)
HOOK(00547208, GetTimerSystemTime)
HOOK(005471b8, iGetTimerSystemTime)
HOOK(00547cf0, SetTimerAlarm)
HOOK(00547e20, iSetTimerAlarm)
HOOK(00547f10, ReleaseTimerAlarm)
HOOK(00547fb8, iReleaseTimerAlarm)
HOOK(0053c568, write)
HOOK(0053c5e8, read)
HOOK(00546718, Exit)

