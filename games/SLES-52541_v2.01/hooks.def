HOOK(003c50f0, batch_flush)
/* the driver's extended render state (x_rs natively, else the original) */
HOOK(00350e90, drv_set_state_ext)
/* the grass (~1.4 ms per frame on the PSP for plants the HLE never draws - the game's VU1 grass renderer 0x48CB80
   has no HLE): x_grass=1 skips both (hle_xgame.c) */
HOOK(00489690, plants_update)
HOOK(00489960, plants_render)
/* the far-collision LOD (x_farcol; 0 = the original) - a developer module (not in every checkout) */
HOOK(00283900, world_process)
/* the camera's world-collision cone cast at half rate (hle_ag.c; x_agcam = cm; 0 = the original) */
HOOK(002261c0, camera_cone_cast)
/* render-only effect passes (hle_au.c), x_fxskip mask (default 0 = the originals): 1 = the stored and static
   shadows, 2 = the plane trails (no-argument functions) */
HOOK(00116180, shadows_stored)
HOOK(00117700, shadows_static)
HOOK(002e1350, plane_trails)
/* the mirror pass of interiors (hle_bd.c; x_mirror=0 skips it; default 1 = the original; no-argument function) */
HOOK(002fa580, mirror_pass)
/* render-list levers (a developer module, not in every checkout), default 0 = the originals: x_scan
   (scan_sector_list: 50 m sectors beyond the far clip skipped), x_ndd (entity_visibility: entities without LOD links
   culled beyond P % of their draw distance), x_vehlod (vis_set_camera: vehicle LOD / component distances x P %) */
HOOK(00272770, scan_sector_list)
HOOK(002713b0, entity_visibility)
HOOK(00291f20, vis_set_camera)

/* ---- 3D world (hle_w3d.c): the mesh node body every one of the game's mesh pipelines runs; building atomics are
   drawn by the PSP GE (ps2rc.cfg world3d and the guest-pipeline switch), everything else - and every atomic when
   world3d=0 - runs the translated original unchanged */
HOOK(00391398, mesh_node_body)

/* ---- water (hle_water.c): the water batch renderer (VU1 water_0..3) - its entries drawn by the GE (ps2rc.cfg
   water / water_*); water=0: the translated original as before (nothing drawn) */
HOOK(00182850, water_render)
HOOK(003c6950, water_batch)

/* ---- the sky (hle_sky.c): sky_polys only marks its scope; the game's immediate-mode 3D buffer flush
   (buffer_render), when called inside it, has the HLE draw the sky gradient (ps2rc.cfg sky / sky_guest); every call
   then runs the translated original unchanged (sky_guest=0: the sky's immediate-mode transform / draw is skipped) */
HOOK(002ede60, sky_polys)
HOOK(002f5de0, buffer_render)

/* ---- less game work per frame (hle_tune.c): the time-of-day update runs its translated original unchanged; with
   ps2rc.cfg tune_* keys the HLE then scales the far clip / fog, the LOD distance scale and the density multipliers
   (all keys default off: nothing written) */
HOOK(00278320, daycycle_update)
/* streaming budget (tune_strmem): the memory manager's emergency paths, counted / timed by hle_tune.c (the originals
   run unchanged) - the allocator 0x1005E0 falls back to them when the heap is full */
HOOK(00244590, heap_defrag)
HOOK(002c5e40, stream_free_behind)

/* ---- the idle camera (hle_idleview.c): idle_view_due runs its translated original (2700 standing-still FRAMES =
   108 s on the PAL PS2, ~225 s at the PSP's ~12 fps); with ps2rc.cfg idle_view=ps2 (PSP default) the answer is the
   same 108 s of real time instead (idle_view=game: the original's) */
HOOK(00207c60, idle_view_due)

/* ---- the PS2 post-processing colour filter (hle_postfx.c): called once per gameplay frame by the post-effects pass
   0x514300 with the two time-of-day filter colours; the HLE multiplies the picture by them (ps2rc.cfg postfx /
   postfx_filter), then runs the translated original (raw GS packets the HLE drops; postfx_guest=0 skips it); the
   glow pass 0x518280 the same way (postfx_radiosity, postfx_rad_guest) */
HOOK(0051a760, postfx_colour)
HOOK(00518280, postfx_glow)

/* ---- overlay 1: the FMV player (hle_game.c; the PSP plays converted movies, the host skips them) */
HOOK_OV(1, 0089ab90, movie_init)
HOOK_OV(1, 0089ac50, movie_shutdown)
HOOK_OV(1, 0089ac60, movie_play)

